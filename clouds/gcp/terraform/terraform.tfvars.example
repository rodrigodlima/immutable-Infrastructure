# Terraform variables example file
# Copy this file to terraform.tfvars and fill with your values

# REQUIRED: Your GCP project ID
project_id = "your-gcp-project"

# GCP region and zone (optional - already has defaults)
region = "us-central1"
zone   = "us-central1-a"

# Instance name (optional)
instance_name = "nginx-immutable-demo"

# Machine type (optional - e2-micro for free tier)
machine_type = "e2-micro"

# Image family created by Packer (must be the same name used in Packer)
image_family = "nginx-immutable-family"

# Environment
environment = "demo"
