# Packer variables example file
# Copy this file to variables.pkrvars.hcl and fill with your values

# REQUIRED: Your GCP project ID
project_id = "your-gcp-project"

# GCP zone
zone = "us-central1-a"

# Base image name
image_name = "nginx-immutable"

# Image family (IMPORTANT: use the same name in Terraform)
image_family = "nginx-immutable-family"
